{
  "name": "soatok/cupcake",
  "description": "PHP utility for building and processing forms",
  "license": "ISC",
  "autoload": {
    "psr-4": {
      "Soatok\\Cupcake\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Soatok\\Cupcake\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "paragonie/ionizer": "^1|^2",
    "paragonie/sodium_compat": "^1|^2",
    "ezyang/htmlpurifier": "^4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.5",
    "soatok/code-style": ">= 0",
    "phpunit/phpunit": "^11|^12|^13",
    "vimeo/psalm": "^6|^7"
  },
  "scripts": {
    "local": [
      "phpunit",
      "psalm --clear-cache", "psalm --show-info=true",
      "psalm --clear-cache", "psalm --taint-analysis"
    ],
    "static-analysis": ["psalm"],
    "taint": ["psalm --taint-analysis"],
    "test": ["phpunit", "psalm", "psalm --taint-analysis"],
    "unit-test": ["phpunit"],
    "style": "php-cs-fixer fix --allow-risky=yes --dry-run --diff",
    "style-fix": "php-cs-fixer fix --allow-risky=yes"
  },
  "suggest": {
    "ext-sodium": "ID population is faster."
  }
}
